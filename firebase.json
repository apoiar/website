{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/ouvidoria",
        "function": {
          "functionId": "ouvidoria",
          "region": "us-east1"
        }
      }
    ]
  }
}
